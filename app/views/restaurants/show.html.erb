<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold">All Restaurants</h1>
    <%= link_to "Add Restaurant", new_restaurant_path, class: "btn btn-primary" %>
  </div>

  <ul class="list-group">
    <% @restaurants.each do |restaurant| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= link_to restaurant.name, restaurant_path(restaurant), class: "text-decoration-none fw-bold" %>
        <span class="badge bg-secondary rounded-pill"><%= restaurant.category %></span>
      </li>
    <% end %>
  </ul>
</div>
